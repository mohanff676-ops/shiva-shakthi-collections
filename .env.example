# Supabase Configuration
# Obtain from Supabase Dashboard > Project Settings > API
# Use ONLY the public anon key. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# WhatsApp Business Concierge Number (with country code, no + prefix)
VITE_WHATSAPP_NUMBER=918971263989

# Site URL
VITE_SITE_URL=http://localhost:5173
